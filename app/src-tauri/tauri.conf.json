{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unpack Forge",
  "version": "0.1.0",
  "identifier": "com.example.unpack-forge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unpack Forge",
        "width": 800,
        "height": 600,
        "minWidth": 660,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "shortDescription": "7z / rar multi-volume extractor",
    "copyright": "MIT",
    "externalBin": [
      "binaries/7zz",
      "binaries/unrar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
